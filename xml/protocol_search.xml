<?xml version="1.0" encoding="UTF-8"?>
<metalib version="1.0" desc="搜索服务RPC协议定义">
    <header name="protocol_search" desc="搜索服务RPC协议定义">

        <macrogroup name="SearchFunc" desc="服务注册功能类型">
            <macro name="SS_FUNC_ID_SEARCH" value="1" desc="搜索服务"/>
            <macro name="SS_FUNC_ID_API" value="2" desc="API 服务"/>
            <macro name="SS_FUNC_ID_CLIENT" value="3" desc="只调用不接收转发请求的客户端"/>
        </macrogroup>

        <macro name="SS_CMD_SEARCH_QUERY" value="200" type="int" desc="搜索文章"/>
        <macro name="SS_CMD_SEARCH_REINDEX" value="201" type="int" desc="重新索引单篇文章"/>
        <macro name="SS_CMD_SEARCH_REBUILD" value="202" type="int" desc="全量重建索引"/>
        <macro name="SS_CMD_SEARCH_HEALTH" value="203" type="int" desc="搜索服务健康状态"/>

        <macrogroup name="SearchCode" desc="搜索结果业务码">
            <macro name="SS_SEARCH_CODE_OK" value="0" desc="成功"/>
            <macro name="SS_SEARCH_CODE_NOT_READY" value="1" desc="索引未就绪"/>
            <macro name="SS_SEARCH_CODE_BUSY" value="2" desc="索引重建中"/>
        </macrogroup>

        <struct name="SearchQuery" desc="搜索请求" serialize="true">
            <entry name="Keyword" type="string" desc="搜索关键词"/>
            <entry name="CategoryId" type="int64" desc="分类 ID"/>
            <entry name="LabelId" type="int64" desc="标签 ID"/>
            <entry name="State" type="int64" desc="文章状态"/>
            <entry name="Channel" type="int64" desc="频道"/>
            <entry name="UserId" type="int64" desc="作者 ID"/>
            <entry name="YearMonth" type="string" desc="发布时间年月"/>
            <entry name="Page" type="int" desc="页码"/>
            <entry name="PageSize" type="int" desc="每页数量"/>
        </struct>

        <struct name="SearchResult" desc="搜索响应" serialize="true">
            <entry name="Code" type="int" desc="业务码"/>
            <entry name="Total" type="int64" desc="命中总数"/>
            <entry name="Ids" type="vector<uint64>" desc="当前页文章 ID"/>
        </struct>

        <struct name="SearchHealth" desc="搜索服务健康状态" serialize="true">
            <entry name="Ready" type="int" desc="是否就绪"/>
            <entry name="Docs" type="int64" desc="索引文档数"/>
            <entry name="BuildTime" type="int64" desc="最近一次构建耗时（秒）"/>
        </struct>

    </header>
</metalib>
